FROM node:22-bookworm-slim AS cli
RUN npm install -g @openai/codex @anthropic-ai/claude-code

FROM python:3.10-slim-bookworm

RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates libstdc++6 \
    && rm -rf /var/lib/apt/lists/*
COPY --from=cli /usr/local/bin/node /usr/local/bin/node
COPY --from=cli /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ln -s /usr/local/lib/node_modules/@openai/codex/bin/codex.js /usr/local/bin/codex \
    && ln -s /usr/local/lib/node_modules/@anthropic-ai/claude-code/cli.js /usr/local/bin/claude

ENV PYTHONUNBUFFERED=1

WORKDIR /app

ENV HOME=/root/agent-home
RUN mkdir -p /root/agent-home /app/agent/logs

COPY pyproject.toml uv.lock ./
RUN pip install uv && uv sync --no-dev

COPY agent/ ./agent/

CMD ["sh", "-c", "uv run -m agent.agent 2>> /app/agent/logs/stderr-${BOT_ID:-agent}.log"]
