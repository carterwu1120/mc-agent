# Copy to .env. Install the selected CLI and sign in with your subscription.
# Direct model API providers have been removed on this branch.

# Switch providers here; no code changes required. Default: codex.
LLM_PROVIDER=codex
# Leave blank for the CLI default model, or set a model your plan supports.
LLM_MODEL=
CLI_AGENT_TIMEOUT=120
# Reuse one provider conversation per bot, including after container recreation.
CLI_SESSION_REUSE=true
# Reuse only within a bounded task conversation; rotate at either limit.
CLI_SESSION_MAX_TURNS=8
CLI_SESSION_MAX_INPUT_TOKENS=200000
# Fallback pause when a usage-limit error does not include a reset timestamp.
CLI_USAGE_LIMIT_COOLDOWN=3600
# Normal logs stay compact; enable only while inspecting raw model context/events.
AGENT_LOG_PROMPTS=false
AGENT_LOG_TICKS=false
RECOVERY_DECISION_TIMEOUT=60
# Optional executable paths, not shell commands:
# CODEX_CLI_PATH=codex
# CLAUDE_CLI_PATH=claude

# Minecraft server connection
MC_HOST=localhost
# Docker Desktop connecting to a Windows-hosted server: MC_HOST=host.docker.internal
MC_PORT=25565
MC_USERNAME=Agent
# Docker Compose uses this name instead of MC_USERNAME:
MC_USERNAME_0=Agent0
MC_VERSION=1.20.1
MC_AUTH=offline
# Vanilla: false. Preserve the old Forge handshake only when using Forge.
MC_FORGE=false
# Experimental mining navigation; enable for the offline-tested pilot.
MC_ADAPTIVE_NAVIGATION=false
BOT_USERNAMES=Agent0,Agent1
STRICT_CHAT_ADDRESSING=true
